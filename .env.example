# Copy to .env and replace every value. Never commit .env.
# Generate each password with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Database superusers: used only for setup and tests, never by a service.
ROLL_DB_SUPERUSER_PASSWORD=change-me
AUTH_DB_SUPERUSER_PASSWORD=change-me
BALLOT_DB_SUPERUSER_PASSWORD=change-me
AUDIT_DB_SUPERUSER_PASSWORD=change-me

# Database logins for each service.
ROLL_AUTH_SVC_PASSWORD=change-me
AUTH_AUTH_SVC_PASSWORD=change-me
BALLOT_BALLOT_SVC_PASSWORD=change-me
BALLOT_COUNT_SVC_PASSWORD=change-me
AUDIT_AUDIT_SVC_PASSWORD=change-me

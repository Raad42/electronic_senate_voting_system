# Copy to .env and replace every value. The real .env is never committed.
# Generate passwords with:  python -c "import secrets; print(secrets.token_urlsafe(24))"

# production (default) | development | test   -- development enables /docs on each service
SV_ENVIRONMENT=production

HTTPS_PORT=8443
# FRONTEND_DIST=./frontend/dist

ROLL_DB_OWNER_PASSWORD=change-me
ROLL_DB_APP_PASSWORD=change-me
AUTH_DB_OWNER_PASSWORD=change-me
AUTH_DB_APP_PASSWORD=change-me
BALLOT_DB_OWNER_PASSWORD=change-me
BALLOT_DB_APP_PASSWORD=change-me
AUDIT_DB_OWNER_PASSWORD=change-me
AUDIT_DB_APP_PASSWORD=change-me
